# Copy to .env with `pnpm run setup` (it fills the secrets and asks for the rest).
# Values below match compose.yaml.
DATABASE_URL=postgres://starter:starter@localhost:5432/starter
TEST_DATABASE_URL=postgres://starter:starter@localhost:5432/starter_test

# The web app (pages, the links in the emails, Google's callback) and the API.
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Generate with: openssl rand -base64 32 (`pnpm run setup` does it). Sessions use it as is;
# cookies and other secrets each get a key derived from it. Only localhost takes this value.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars

# How people sign in, comma separated: magic-link, password, google. `pnpm run setup` asks.
AUTH_METHODS=magic-link

# The header where the platform's proxy puts the caller's IP, for the rate limits. Fly.io sets
# Fly-Client-IP and overwrites what the client sent. Behind another proxy use its header (e.g.
# cf-connecting-ip); locally it's unset and every request shares one bucket.
CLIENT_IP_HEADER=fly-client-ip

# Only with google in AUTH_METHODS: an OAuth client (Web application) in Google Cloud with the
# redirect URI ${APP_URL}/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailpit locally (http://localhost:8025 shows every email). In production any SMTP server:
# Resend (smtp.resend.com, 465, user "resend", password = API key, SMTP_SECURE=true), Postmark,
# SES… `pnpm fly:secrets` refuses Mailpit's values.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Starter <hello@starter.example>"
MAILPIT_URL=http://localhost:8025
