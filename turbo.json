{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "CHROME_PATH",
    "CI"
  ]
}
