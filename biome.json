{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/migrations/meta",
      "!**/.react-router",
      "!**/build",
      "!**/.lighthouseci",
      "!**/playwright-report",
      "!**/test-results",
      "!pnpm-lock.yaml",
      "!.agents/skills",
      "!.claude/agents"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/e2e/tests/**"],
      "plugins": [
        "./apps/e2e/lint/no-wait-for-timeout.grit",
        "./apps/e2e/lint/no-networkidle.grit",
        "./apps/e2e/lint/no-only.grit",
        "./apps/e2e/lint/no-force.grit",
        "./apps/e2e/lint/no-xpath.grit"
      ]
    }
  ]
}
